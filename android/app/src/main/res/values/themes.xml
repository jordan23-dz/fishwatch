<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <color name="fw_paper">#EDF1F0</color>
    <color name="fw_teal">#0D5C6C</color>
    <style name="Theme.FishWatch" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/fw_paper</item>
        <item name="android:colorPrimary">@color/fw_teal</item>
        <item name="android:colorAccent">@color/fw_teal</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>
    </style>
</resources>
